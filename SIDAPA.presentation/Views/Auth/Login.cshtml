@model LoginViewModel
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
    var error = ViewData.ModelState[string.Empty]?.Errors.FirstOrDefault()?.ErrorMessage;
}

@section Styles {
    <link rel="stylesheet" href="~/css/auth/login.css" asp-append-version="true" />
}

<main class="login-page container-fluid">
    <div class="row min-vh-100">
        @* Fondo decorativo: solo en pantallas grandes, sin interacción. *@
        <div class="col-lg-7 d-none d-lg-block login-bg" aria-hidden="true">
            <div class="login-bg__layer"></div>
        </div>

        <div class="col-12 col-lg-5 d-flex align-items-center justify-content-center px-4 py-5 login-side">
            <div class="login-stage w-100" id="loginStage">
                <div class="card login-card border-0 shadow rounded-4">
                    <form asp-controller="Auth" asp-action="Login" method="post" id="loginForm" class="card-body p-4 p-md-5">
                        @*
                            Botón circular del wireframe. Por ahora envía el mismo formulario.
                            Para darle otra acción: cambiar a type="button", poner data-login-action="<nombre>"
                            y agregar el manejador en loginActions de wwwroot/js/auth/login.js.
                        *@
                        <button type="submit" class="login-arrow btn btn-light border shadow-sm rounded-circle"
                                data-login-action="submit" aria-label="Iniciar sesión">
                            <span aria-hidden="true">&larr;</span>
                        </button>

                        <h1 class="h2 fw-bold text-center mb-4">SIDAPA</h1>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control rounded-pill px-3" placeholder="Ingrese su correo"
                                   autocomplete="username" inputmode="email" required autofocus />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control rounded-pill px-3" placeholder="Ingrese su contraseña"
                                   autocomplete="current-password" required />
                        </div>

                        <div id="loginError" class="alert alert-danger py-2 small @(error is null ? "d-none" : "")" role="alert">@error</div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2" data-login-action="submit">
                            <span class="spinner-border spinner-border-sm me-2 d-none" aria-hidden="true" data-login-spinner></span>
                            Iniciar sesión
                        </button>
                    </form>
                </div>
                @* Panel blanco que ocupa el lugar de la tarjeta al iniciar sesión (ver login.css). *@
                <div class="login-wipe rounded-4" aria-hidden="true"></div>
            </div>
        </div>
    </div>
</main>

@section Scripts {
    <script src="~/js/auth/login.js" asp-append-version="true"></script>
}
